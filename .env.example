# ---- App ----
ENV=development
APP_NAME=ai-qa-api
SERVICE_VERSION=0.2.0

# ---- Security ----
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
JWT_ISSUER=ai-qa-api
JWT_AUDIENCE=ai-qa-api-clients

# ---- Database ----
# (docker compose overrides DATABASE_URL to point at the "db" service using
#  the POSTGRES_* values below)
DATABASE_URL=postgresql+psycopg2://appuser:change-me-local-only@localhost:5432/appdb
DB_AUTO_CREATE=true
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=appdb

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Cache ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_PREFIX=chat:answer:

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_PER_MINUTE=3000

# ---- LLM ----
LLM_PROVIDER=openai
# Any OpenAI-compatible endpoint. For a local Ollama from docker compose:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2:1b  LLM_FALLBACK_MODEL=
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4.1-nano
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENCY=50
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=4.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_SYSTEM_PROMPT=You are a concise, helpful assistant.

# ---- Observability ----
METRICS_ENABLED=true
# Bearer token for Prometheus scraping (openssl rand -hex 24). Empty = admin JWT only.
METRICS_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Bootstrap users (created on startup only if the password is set) ----
# Choose your own values; nothing is hard-coded in the source.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
DEMO_USER_PASSWORD=
DEMO_READONLY_PASSWORD=
